<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logout - MatchFlix</title>
</head>

<body>
    <div class="d-flex justify-content-center align-items-center vh-100" style="background-color: #f8f9fa;">
        <div class="card shadow-lg p-4" style="width: 400px; border-radius: 16px;">
            <div class="text-center mb-4">
                <h3 class="fw-bold">
                    🎬 MatchFlix
                </h3>
                <p class="text-muted mb-0">
                    You've been successfully logged out
                </p>
            </div>
            
            <div class="text-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle text-success" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                </svg>
            </div>

            <p class="text-center text-muted mb-4">
                Thanks for using MatchFlix! Come back soon to discover more movies.
            </p>

            <a href="/login" class="btn w-100 text-white fw-semibold" style="background-color: #000022;">
                Sign In Again
            </a>

            <div class="text-center mt-3">
                <small class="text-muted">
                    Need a new account? <a href="/register" class="text-primary fw-semibold text-decoration-none">Sign Up!</a>
                </small>
            </div>
        </div>
    </div>
</body>

</html>