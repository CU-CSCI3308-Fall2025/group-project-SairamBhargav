<style>
    .swipe-row {
        text-align: center;
    }

    /* Poster wrapper */
    .poster-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }

    /* Poster scaled down so page fits */
    .swipe-poster {
        width: 100%;
        height: auto;
        max-height: 500px;
        object-fit: contain;
        border-radius: 12px;
        background-color: #e8e8e8;
    }

    .swipe-card {
        border-radius: 12px;
        background: #ffffff;
        padding-bottom: 5px;
    }

    /* Hover overlay */
    .movie-info-overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;

        background: rgba(0, 0, 0, 0.75);
        color: #ffffff;

        padding: 10px 12px;

        opacity: 0;
        transform: translateY(100%);
        transition: opacity 0.25s ease, transform 0.25s ease;

        max-height: 45%;
        overflow-y: auto;
    }

    .poster-wrapper:hover .movie-info-overlay {
        opacity: 1;
        transform: translateY(0);
    }

    .overlay-title {
        font-size: 1rem;
        font-weight: 600;
    }

    .overlay-text {
        font-size: 0.85rem;
    }

    /* Large side buttons */
    .bigVoteBtn {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: none;
        background: #ffffff;
        font-size: 45px;
        cursor: pointer;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.25);
        transition: 0.2s;
    }

    .bigVoteBtn:active {
        transform: scale(0.93);
    }

    /* Active glow colors */
    .bigVoteBtn.likeActive {
        background-color: #d3f9d8;
        border: 3px solid #2f9e44;
    }

    .bigVoteBtn.dislikeActive {
        background-color: #ffa8a8;
        border: 3px solid #e00b0b;
    }
    
    #like-btn {
        background: linear-gradient(to right, #d3f9d8 50%, #ffffff 50%);
        background-size: 200% 100%;
        background-position: right bottom;
        transition: all 0.9s ease;
    }

    #like-btn:hover {
        background-position: left bottom;
        transition: all .5s;
        transform: scale(1.1);
    }

    #dislike-btn {
        background: linear-gradient(to right, #ffa8a8 50%, #ffffff 50%);
        background-size: 200% 100%;
        background-position: right bottom;
        transition: all 0.9s ease;
    }

    #dislike-btn:hover {
        background-position: left bottom;
        transition: all .5s;
        transform: scale(1.1);
    }

    #skip-btn:hover{
        transition: all .5s;
        transform: scale(1.2);
    }

    /* Recommendation modal */
    .reco-modal {
        position: fixed;
        inset: 0;
        display: none; /* hidden by default */
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .reco-modal.show {
        display: flex;
    }

    .reco-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
    }

    .reco-content {
        position: relative;
        background: #ffffff;
        border-radius: 16px;
        max-width: 900px;
        width: 90%;
        max-height: 80vh;
        padding: 20px;
        overflow-y: auto;
        box-shadow: 0 0 30px rgba(0,0,0,0.35);
    }

    .reco-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 12px;
    }

    .reco-card {
        flex: 1 1 200px;
        max-width: 220px;
        border-radius: 12px;
        border: 1px solid #ddd;
        overflow: hidden;
        background: #f9f9f9;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .reco-card img {
        width: 100%;
        height: 260px;
        object-fit: cover;
    }

    .reco-card-body {
        padding: 10px 12px;
        font-size: 0.9rem;
    }

    .reco-card-title {
        font-weight: 600;
        margin-bottom: 4px;
        font-size: 0.95rem;
    }

    .reco-card-text {
        font-size: 0.8rem;
        max-height: 80px;
        overflow: hidden;
    }

    .reco-meta {
        font-size: 0.75rem;
        color: #666;
        margin-top: 4px;
    }
</style>

{{> navbar}}

<div class="container mt-3">

    <h2 class="text-center">🎥 Swipe for Movies!</h2>
    <p class="text-center">Welcome, {{username}}!</p>

    {{#if error}}
    <div class="alert alert-danger text-center">
        {{error}}
    </div>
    {{/if}}

    {{#if movie}}

    <div class="row swipe-row mt-3 justify-content-center align-items-center">

        <!-- Hidden username for JS -->
        <input type="hidden" id="username-hidden" value="{{username}}">
        <!-- Hidden movie id if you ever need it in JS -->
        <input type="hidden" id="movie-id" value="{{movie.id}}">

        <!-- LEFT DISLIKE BUTTON -->
        <div class="col-2 text-center">
            <form method="POST" action="/movies/dislike/{{movie.id}}">
                <button type="submit" id="dislike-btn" class="bigVoteBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#e00b0b" viewBox="0 0 256 256">
                        <path
                            d="M239.82,157l-12-96A24,24,0,0,0,204,40H32A16,16,0,0,0,16,56v88a16,16,0,0,0,16,16H75.06l37.78,75.58A8,8,0,0,0,120,240a40,40,0,0,0,40-40V184h56a24,24,0,0,0,23.82-27ZM72,144H32V56H72Zm150,21.29a7.88,7.88,0,0,1-6,2.71H152a8,8,0,0,0-8,8v24a24,24,0,0,1-19.29,23.54L88,150.11V56H204a8,8,0,0,1,7.94,7l12,96A7.87,7.87,0,0,1,222,165.29Z">
                        </path>
                    </svg>
                </button>
            </form>
        </div>

        <!-- POSTER + HOVER INFO -->
        <div class="col-8">
            <div class="swipe-card">
                <div class="poster-wrapper">

                    {{#if movie.posterPath}}
                    <img src="{{movie.posterPath}}" class="swipe-poster" alt="{{movie.title}}" />
                    {{else}}
                    <div class="d-flex align-items-center justify-content-center"
                        style="height: 400px; background: #222; border-radius: 12px;">
                        <span class="text-white">No Image</span>
                    </div>
                    {{/if}}

                    <!-- Hover overlay -->
                    <div class="movie-info-overlay">
                        <div class="overlay-title">{{movie.title}}</div>
                        <div class="overlay-text">{{movie.overview}}</div>
                        <div class="overlay-text mt-2">
                            ⭐ Rating: {{movie.rating}}/10 <br>
                            📅 Release: {{movie.releaseDate}}
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- RIGHT LIKE BUTTON -->
        <div class="col-2 text-center">
            <form method="POST" action="/movies/like/{{movie.id}}">
                <button type="submit" id="like-btn" class="bigVoteBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#2f9e44" viewBox="0 0 256 256">
                        <path
                            d="M178,40c-20.65,0-38.73,8.88-50,23.89C116.73,48.88,98.65,40,78,40a62.07,62.07,0,0,0-62,62c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,228.66,240,172,240,102A62.07,62.07,0,0,0,178,40ZM128,214.8C109.74,204.16,32,155.69,32,102A46.06,46.06,0,0,1,78,56c19.45,0,35.78,10.36,42.6,27a8,8,0,0,0,14.8,0c6.82-16.67,23.15-27,42.6-27a46.06,46.06,0,0,1,46,46C224,155.61,146.24,204.15,128,214.8Z">
                        </path>
                    </svg>
                </button>
            </form>
        </div>

    </div>

    <!-- NEXT MOVIE BUTTON BELOW EVERYTHING -->
    <div class="text-center mt-4">
            <a href="/swipe" id = "skip-btn" class="btn btn-dark btn-lg px-4">
                Skip
            </a>
    </div>

    {{else}}
    <p class="text-center mt-5">No movie available.</p>
    {{/if}}

</div>

<!-- Recommendation popup modal -->
<div id="reco-modal" class="reco-modal">
    <div class="reco-backdrop"></div>
    <div class="reco-content">
        <h4>✨ Recommended for you</h4>
        <p class="text-muted mb-2" style="font-size: 0.9rem;">
            Based on your recent swipes, here are some movies you might like:
        </p>
        <div id="reco-list" class="reco-grid"></div>
        <div class="text-end mt-3">
            <button id="reco-close" class="btn btn-dark">Back to swiping</button>
        </div>
    </div>
</div>

<script>
    // Visual button state (green/red glow)
    document.addEventListener("DOMContentLoaded", function () {
        const likeBtn = document.getElementById("like-btn");
        const dislikeBtn = document.getElementById("dislike-btn");

        if (likeBtn) {
            likeBtn.addEventListener("mousedown", () => {
                likeBtn.classList.add("likeActive");
                dislikeBtn && dislikeBtn.classList.remove("dislikeActive");
            });
        }

        if (dislikeBtn) {
            dislikeBtn.addEventListener("mousedown", () => {
                dislikeBtn.classList.add("dislikeActive");
                likeBtn && likeBtn.classList.remove("likeActive");
            });
        }
    });

    // Recommendation popup logic (every 10 swipes)
    document.addEventListener("DOMContentLoaded", function () {
        const usernameInput = document.getElementById("username-hidden");
        const modal = document.getElementById("reco-modal");
        const closeBtn = document.getElementById("reco-close");
        const recoList = document.getElementById("reco-list");

        console.log("DEBUG: swipe JS loaded");

        if (!usernameInput || !modal || !recoList) {
            console.log("DEBUG: missing elements", { usernameInput, modal, recoList });
            return;
        }

        const username = usernameInput.value;
        if (!username) {
            console.log("DEBUG: no username");
            return;
        }

        const key = "swipeCount_" + username;
        let count = parseInt(localStorage.getItem(key) || "0", 10);
        if (isNaN(count)) count = 0;

        count += 1;
        localStorage.setItem(key, String(count));

        console.log("DEBUG: username =", username, "swipe count =", count);

        if (count % 10 === 0) {
            console.log("DEBUG: triggering recommendations fetch");

            fetch("/api/recommendations/generate", {
                method: "POST"
            })
            .then(async (res) => {
                console.log("DEBUG: /api/recommendations/generate status =", res.status);
                if (!res.ok) {
                    throw new Error("Status " + res.status);
                }
                return res.json();
            })
            .then((data) => {
                console.log("DEBUG: recommendations response", data);

                if (!data || !Array.isArray(data.recommendations)) return;

                recoList.innerHTML = "";

                data.recommendations.forEach((movie) => {
                    const card = document.createElement("div");
                    card.className = "reco-card";

                    const imgSrc = movie.poster_path
                        ? "https://image.tmdb.org/t/p/w500" + movie.poster_path
                        : null;

                    if (imgSrc) {
                        const img = document.createElement("img");
                        img.src = imgSrc;
                        img.alt = movie.title || "Movie poster";
                        card.appendChild(img);
                    }

                    const body = document.createElement("div");
                    body.className = "reco-card-body";

                    const title = document.createElement("div");
                    title.className = "reco-card-title";
                    title.textContent = movie.title || "Untitled";
                    body.appendChild(title);

                    const overview = document.createElement("div");
                    overview.className = "reco-card-text";
                    overview.textContent = movie.overview || "No overview available.";
                    body.appendChild(overview);

                    const meta = document.createElement("div");
                    meta.className = "reco-meta";
                    const rating = movie.vote_average ? `⭐ ${movie.vote_average}` : "";
                    const date = movie.release_date ? ` • 📅 ${movie.release_date}` : "";
                    meta.textContent = rating + date;
                    body.appendChild(meta);

                    card.appendChild(body);
                    recoList.appendChild(card);
                });

                modal.classList.add("show");
            })
            .catch((err) => {
                console.warn("Could not load recommendations:", err.message);
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", () => {
                modal.classList.remove("show");
            });
        }

        const backdrop = modal.querySelector(".reco-backdrop");
        if (backdrop) {
            backdrop.addEventListener("click", () => {
                modal.classList.remove("show");
            });
        }
    });
</script>