{{> navbar }}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    
    <div class="container mt-4">
        <h1>Random Movie</h1>
        <p>Welcome, {{username}}!</p>
    
        {{#if error}}
        <div class="alert alert-danger">{{error}}</div>
        {{/if}}
    
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card h-100">
                    {{#if movie.posterPath}}
                    <img src="{{movie.posterPath}}" class="card-img-top" alt="{{movie.title}}" />
                    {{else}}
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                        style="height: 450px;">
                        <span class="text-white">No Image</span>
                    </div>
                    {{/if}}
                    <div class="card-body">
                        <h5 class="card-title">{{movie.title}}</h5>
                        <p class="card-text">{{movie.overview}}</p>
                        <p class="text-muted">Rating: {{movie.rating}}/10</p>
                        <p class="text-muted">Release: {{movie.releaseDate}}</p>
                    </div>
                    <div class="card-footer d-flex justify-content-around bg-white border-top">
                        <form method="POST" action="/movies/like/{{movie.id}}" class="flex-fill me-2">
                            <button type="submit" class="btn btn-success btn-lg w-100">
                                Like
                            </button>
                        </form>
                        <form method="POST" action="/movies/dislike/{{movie.id}}" class="flex-fill ms-2">
                            <button type="submit" class="btn btn-danger btn-lg w-100">
                                Dislike
                            </button>
                        </form>
                    </div>
                </div>
    
                <div class="text-center mt-4">
                    <a href="/movies/random" class="btn btn-primary">
                        Get Another Random Movie
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>