{{> navbar}}

<div class="container mt-3">

  <h2 class="text-center">🎥 Swipe for Movies!</h2>
  <p class="text-center">Welcome, {{username}}!</p>

  {{#if error}}
    <div class="alert alert-danger text-center">
      {{error}}
    </div>
  {{/if}}

  {{#if movie}}

    <div class="row swipe-row mt-3 justify-content-center align-items-center">

      <!-- LEFT DISLIKE BUTTON -->
      <div class="col-2 text-center">
        <button id="dislike-btn" class="bigVoteBtn">
          👎
        </button>
      </div>

      <!-- POSTER + HOVER INFO -->
      <div class="col-8">
        <div class="swipe-card">

          <div class="poster-wrapper">

            {{#if movie.posterPath}}
              <img 
                src="{{movie.posterPath}}" 
                class="swipe-poster"
                alt="{{movie.title}}"
              />
            {{else}}
              <div class="d-flex align-items-center justify-content-center"
                   style="height: 400px; background: #222; border-radius: 12px;">
                <span class="text-white">No Image</span>
              </div>
            {{/if}}

            <!-- Hover overlay -->
            <div class="movie-info-overlay">
              <div class="overlay-title">{{movie.title}}</div>
              <div class="overlay-text">{{movie.overview}}</div>
              <div class="overlay-text mt-2">
                ⭐ Rating: {{movie.rating}}/10 <br>
                📅 Release: {{movie.releaseDate}}
              </div>
            </div>

          </div>

        </div>
      </div>

      <!-- RIGHT LIKE BUTTON -->
      <div class="col-2 text-center">
        <button id="like-btn" class="bigVoteBtn">
          👍
        </button>
      </div>

    </div>

    <!-- NEXT MOVIE BUTTON BELOW EVERYTHING -->
    <div class="text-center mt-4">
      <a href="/swipe" class="btn btn-dark btn-lg px-4">
        Next Movie
      </a>
    </div>

  {{else}}
    <p class="text-center mt-5">No movie available.</p>
  {{/if}}

</div>

<style>
  .swipe-row {
    text-align: center;
  }

  /* Poster wrapper */
  .poster-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }

  /* Poster scaled down so page fits */
  .swipe-poster {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: contain;
    border-radius: 12px;
    background-color: #e8e8e8;
  }

  .swipe-card {
    border-radius: 12px;
    background: #ffffff;
    padding-bottom: 5px;
  }

  /* Hover overlay */
  .movie-info-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;

    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;

    padding: 10px 12px;

    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.25s ease, transform 0.25s ease;

    max-height: 45%;
    overflow-y: auto;
  }

  .poster-wrapper:hover .movie-info-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .overlay-title {
    font-size: 1rem;
    font-weight: 600;
  }

  .overlay-text {
    font-size: 0.85rem;
  }

  /* Large side buttons */
  .bigVoteBtn {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: none;
    background: #ffffff;
    font-size: 45px;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(0,0,0,0.25);
    transition: 0.2s;
  }

  .bigVoteBtn:active {
    transform: scale(0.93);
  }

  /* Active glow colors */
  .bigVoteBtn.likeActive {
    background-color: #d3f9d8;
    border: 3px solid #2f9e44;
  }

  .bigVoteBtn.dislikeActive {
    background-color: #ffa8a8;
    border: 3px solid #e00b0b;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const likeBtn = document.getElementById("like-btn");
    const dislikeBtn = document.getElementById("dislike-btn");

    likeBtn.addEventListener("click", () => {
      likeBtn.classList.add("likeActive");
      dislikeBtn.classList.remove("dislikeActive");
    });

    dislikeBtn.addEventListener("click", () => {
      dislikeBtn.classList.add("dislikeActive");
      likeBtn.classList.remove("likeActive");
    });
  });
</script>