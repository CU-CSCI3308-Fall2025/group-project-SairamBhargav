<style>
    .swipe-row {
        text-align: center;
    }

    /* Poster wrapper */
    .poster-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }

    /* Poster scaled down so page fits */
    .swipe-poster {
        width: 100%;
        height: auto;
        max-height: 500px;
        object-fit: contain;
        border-radius: 12px;
        background-color: #e8e8e8;
    }

    .swipe-card {
        border-radius: 12px;
        background: #ffffff;
        padding-bottom: 5px;
    }

    /* Hover overlay */
    .movie-info-overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;

        background: rgba(0, 0, 0, 0.75);
        color: #ffffff;

        padding: 10px 12px;

        opacity: 0;
        transform: translateY(100%);
        transition: opacity 0.25s ease, transform 0.25s ease;

        max-height: 45%;
        overflow-y: auto;
    }

    .poster-wrapper:hover .movie-info-overlay {
        opacity: 1;
        transform: translateY(0);
    }

    .overlay-title {
        font-size: 1rem;
        font-weight: 600;
    }

    .overlay-text {
        font-size: 0.85rem;
    }

    /* Large side buttons */
    .bigVoteBtn {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: none;
        background: #ffffff;
        font-size: 45px;
        cursor: pointer;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.25);
        transition: 0.2s;
    }

    .bigVoteBtn:active {
        transform: scale(0.93);
    }

    /* Active glow colors */
    .bigVoteBtn.likeActive {
        background-color: #d3f9d8;
        border: 3px solid #2f9e44;
    }

    .bigVoteBtn.dislikeActive {
        background-color: #ffa8a8;
        border: 3px solid #e00b0b;
    }
    
    #like-btn {
        background: linear-gradient(to right, #d3f9d8 50%, #ffffff 50%);
        background-size: 200% 100%;
        background-position: right bottom;
        transition: all 0.9s ease;
    }

    #like-btn:hover {
        background-position: left bottom;
        transition: all .5s;
        transform: scale(1.1);
    }

    #dislike-btn {
        background: linear-gradient(to right, #ffa8a8 50%, #ffffff 50%);
        background-size: 200% 100%;
        background-position: right bottom;
        transition: all 0.9s ease;
    }

    #dislike-btn:hover {
        background-position: left bottom;
        transition: all .5s;
        transform: scale(1.1);
    }

    #skip-btn:hover{
        transition: all .5s;
        transform: scale(1.2);
    }
</style>

