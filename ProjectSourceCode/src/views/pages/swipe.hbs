{{> navbar }}

<div class="container mt-4">

  <h1 class="text-center">Swipe Movie</h1>
  <p class="text-center">Welcome, {{username}}!</p>

  {{#if error}}
    <div class="alert alert-danger text-center">
      {{error}}
    </div>
  {{/if}}

  {{#if movie}}
    <div class="row justify-content-center mt-4">
      <div class="col-md-6">

        <div class="card h-100 position-relative">

          <!-- LEFT BUTTON (dislike) -->
          <button id="dislike-btn" class="sideButton dislikeSide">
            👎
          </button>

          <!-- RIGHT BUTTON (like) -->
          <button id="like-btn" class="sideButton likeSide">
            👍
          </button>

          {{#if movie.posterPath}}
            <img 
              src="{{movie.posterPath}}" 
              class="card-img-top swipe-poster"
              alt="{{movie.title}}" 
            />
          {{else}}
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                 style="height: 300px;">
              <span class="text-white">No Image</span>
            </div>
          {{/if}}

          <div class="card-body text-center">
            <h5 class="card-title">{{movie.title}}</h5>
            <p class="card-text">{{movie.overview}}</p>
            <p class="text-muted">Rating: {{movie.rating}}/10</p>
            <p class="text-muted">Release: {{movie.releaseDate}}</p>

            <a href="/swipe" class="btn btn-outline-dark mt-3">
              Next Movie
            </a>
          </div>

        </div>

      </div>
    </div>
  {{else}}
    <p class="text-center mt-5">No movie available.</p>
  {{/if}}

</div>

<style>
  /* Poster size */
  .swipe-poster {
    max-height: 300px;
    object-fit: cover;
  }

  /* LEFT & RIGHT BUTTONS */
  .sideButton {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: none;
    background: #ffffff;
    font-size: 28px;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
    box-shadow: 0 0 5px rgba(0,0,0,0.2);
  }

  .dislikeSide {
    left: -35px;
  }

  .likeSide {
    right: -35px;
  }

  /* Active colors */
  .sideButton.likeActive {
    background-color: #d3f9d8;
    border: 2px solid #2f9e44;
  }

  .sideButton.dislikeActive {
    background-color: #ffa8a8;
    border: 2px solid #e00b0b;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const likeBtn = document.getElementById("like-btn");
    const dislikeBtn = document.getElementById("dislike-btn");

    likeBtn.addEventListener("click", () => {
      likeBtn.classList.add("likeActive");
      dislikeBtn.classList.remove("dislikeActive");
    });

    dislikeBtn.addEventListener("click", () => {
      dislikeBtn.classList.add("dislikeActive");
      likeBtn.classList.remove("likeActive");
    });
  });
</script>