{{> navbar }}

<div class="container my-4">

  <div class="row align-items-center mb-4">
    <div class="col-12">
      <h1 class="display-5 fw-bold mb-2">Discover Movies</h1>
      <p class="lead mb-0">
        Welcome, <span class="fw-semibold">{{username}}</span> — explore trending titles, hidden gems, and all-time favorites.
      </p>
    </div>
  </div>

  {{#if error}}
    <div class="alert alert-danger shadow-sm">
      {{error}}
    </div>
  {{/if}}

  {{#if movies}}
    <div class="row g-4" id="movies-container">
      {{#each movies}}
        <div class="col-6 col-md-4 col-lg-3 d-flex">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden movie-card w-100" data-movie-id="{{id}}">
            {{#if posterPath}}
              <div class="position-relative movie-poster-container">
                <img
                  src="{{posterPath}}"
                  class="card-img-top movie-poster"
                  alt="{{title}}"
                  style="object-fit: cover; height: 400px;"
                />
                <span
                  class="position-absolute top-0 end-0 m-2 badge bg-warning text-dark rounded-pill px-3 py-2"
                  style="backdrop-filter: blur(6px); z-index: 2;"
                >
                  ⭐ {{rating}}/10
                </span>
                
                <!-- Hover overlay with info -->
                <div class="movie-overlay">
                  <div class="movie-info p-3">
                    <h5 class="text-white mb-2">{{title}}</h5>
                    <p class="text-white small mb-2 movie-overview">{{overview}}</p>
                    <p class="text-white-50 small mb-3">
                      {{#if releaseDate}}Released: {{releaseDate}}{{else}}Coming Soon{{/if}}
                    </p>
                    
                    <!-- Action buttons -->
                    <div class="d-flex gap-2 justify-content-center">
                      <button class="btn btn-success btn-sm like-btn" data-movie-id="{{id}}">
                        <i class="bi bi-heart-fill"></i> Like
                      </button>
                      <button class="btn btn-danger btn-sm dislike-btn" data-movie-id="{{id}}">
                        <i class="bi bi-x-circle-fill"></i> Pass
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {{else}}
              <div
                class="card-img-top bg-dark d-flex align-items-center justify-content-center text-center text-white"
                style="height: 400px;"
              >
                <div>
                  <div class="mb-2 fs-3">🎬</div>
                  <div class="fw-semibold">No Poster Available</div>
                </div>
              </div>
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-center align-items-center gap-3 mt-5 mb-4">
      {{#if hasPrevPage}}
        <a href="/discover?page={{@root.currentPage}}&prev=true" class="btn btn-outline-primary pagination-btn" data-page="{{@root.currentPage}}" data-action="prev">
          <i class="bi bi-chevron-left"></i> Previous
        </a>
      {{else}}
        <button class="btn btn-outline-secondary" disabled>
          <i class="bi bi-chevron-left"></i> Previous
        </button>
      {{/if}}

      <span class="badge bg-primary px-4 py-2 fs-6">
        Page {{currentPage}} of {{totalPages}}
      </span>

      {{#if hasNextPage}}
        <a href="/discover?page={{@root.currentPage}}&next=true" class="btn btn-outline-primary pagination-btn" data-page="{{@root.currentPage}}" data-action="next">
          Next <i class="bi bi-chevron-right"></i>
        </a>
      {{else}}
        <button class="btn btn-outline-secondary" disabled>
          Next <i class="bi bi-chevron-right"></i>
        </button>
      {{/if}}
    </div>

  {{else}}
    <div class="text-center py-5">
      <h3 class="fw-semibold mb-2">No movies to display… yet.</h3>
      <p class="text-muted mb-3">
        Try going to the next page to see more movies!
      </p>
      {{#if hasNextPage}}
        <a href="/discover?page=2" class="btn btn-primary">
          View More Movies <i class="bi bi-chevron-right"></i>
        </a>
      {{/if}}
    </div>
  {{/if}}

</div>

<style>
  .movie-card {
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  
  .movie-poster-container {
    position: relative;
    overflow: hidden;
  }
  
  .movie-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.9));
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
    z-index: 1;
  }
  
  .movie-card:hover .movie-overlay {
    opacity: 1;
  }
  
  .movie-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 1rem 1.5rem rgba(0, 0, 0, 0.15);
  }
  
  .movie-info {
    width: 100%;
  }
  
  .movie-overview {
    max-height: 4.5em;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  
  .movie-card.removing {
    animation: fadeOut 0.5s ease forwards;
  }
  
  @keyframes fadeOut {
    to {
      opacity: 0;
      transform: scale(0.8);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Handle pagination buttons
    document.querySelectorAll('.pagination-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const currentPage = parseInt(this.dataset.page);
        const action = this.dataset.action;
        const newPage = action === 'next' ? currentPage + 1 : currentPage - 1;
        window.location.href = `/discover?page=${newPage}`;
      });
    });

    // Handle like buttons
    document.querySelectorAll('.like-btn').forEach(btn => {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        const movieId = this.dataset.movieId;
        const card = this.closest('.movie-card');
        
        try {
          const response = await fetch(`/movies/like/${movieId}`, {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });
          
          if (response.ok) {
            // Add removing animation
            card.classList.add('removing');
            
            // Remove card after animation
            setTimeout(() => {
              card.closest('.col-6').remove();
            }, 500);
          }
        } catch (error) {
          console.error('Error liking movie:', error);
          alert('Failed to like movie. Please try again.');
        }
      });
    });
    
    // Handle dislike buttons
    document.querySelectorAll('.dislike-btn').forEach(btn => {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        const movieId = this.dataset.movieId;
        const card = this.closest('.movie-card');
        
        try {
          const response = await fetch(`/movies/dislike/${movieId}`, {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });
          
          if (response.ok) {
            // Add removing animation
            card.classList.add('removing');
            
            // Remove card after animation
            setTimeout(() => {
              card.closest('.col-6').remove();
            }, 500);
          }
        } catch (error) {
          console.error('Error disliking movie:', error);
          alert('Failed to dislike movie. Please try again.');
        }
      });
    });
  });
</script>