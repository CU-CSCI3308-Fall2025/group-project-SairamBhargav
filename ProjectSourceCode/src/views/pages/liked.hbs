<h1> Like Movies Bank</h1>
<h2 style="color: lightgray;"> {{numOFLiked}} movies in your collection </h2>

<div class="movie">
    {{#each likedMovies}}
        <div class="card">
            <h3>{{name}}</h3>
            <img src="{{poster_url}}" alt="{{name}}" width="300">
            {{#if review < 5}}
                <span class="badge text-bg-danger">{{review}}</span>
            {{else}}
                <span class="badge text-bg-success">{{review}}</span>
            <p style="color: lightgray;">{{year_of_release}}</p>
            <span class="badge text-bg-light">{{genre}}</span>
        </div>
    {{/each}}
</div>