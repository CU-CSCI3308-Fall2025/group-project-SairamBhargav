{{> navbar }}

<div class="container my-4">

  <!-- Header -->
  <div class="row align-items-center mb-4">
    <div class="col-12">
      <h1 class="display-5 fw-bold mb-2">
        {{username}}'s Favorite Movies
      </h1>
      <p class="lead mb-0">
        Here are all the movies you've liked — your personal MatchFlix collection.
      </p>
    </div>
  </div>

  {{#if error}}
    <div class="alert alert-danger shadow-sm">
      {{error}}
    </div>
  {{/if}}

  {{#if movies}}
    <div class="row g-4">
      {{#each movies}}
        <div class="col-6 col-md-4 col-lg-3 d-flex">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-card w-100">
            {{#if posterPath}}
              <div class="position-relative">
                <img
                  src="{{posterPath}}"
                  class="card-img-top"
                  alt="{{title}}"
                  style="object-fit: cover; height: 360px;"
                />
                <span
                  class="position-absolute top-0 end-0 m-2 badge bg-warning text-dark rounded-pill px-3 py-2"
                  style="backdrop-filter: blur(6px);"
                >
                  ⭐ {{rating}}/10
                </span>
              </div>
            {{else}}
              <div
                class="card-img-top bg-dark d-flex align-items-center justify-content-center text-center text-white"
                style="height: 360px;"
              >
                <div>
                  <div class="mb-2 fs-3">🎬</div>
                  <div class="fw-semibold">No Poster Available</div>
                </div>
              </div>
            {{/if}}

            <div class="card-body d-flex flex-column">
              <h5 class="card-title mb-2" title="{{title}}">
                {{title}}
              </h5>

              <!-- Full description, no truncation -->
              <p class="card-text text-muted small mb-2">
                {{overview}}
              </p>

              <!-- Fills empty space so shorter descriptions still line up -->
              <div class="flex-grow-1"></div>

              <div class="mt-2 d-flex justify-content-between align-items-center small text-muted">
                <span class="badge bg-secondary bg-opacity-75">
                  {{#if releaseDate}}Released: {{releaseDate}}{{else}}Coming Soon{{/if}}
                </span>
              </div>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="text-center py-5">
      <h3 class="fw-semibold mb-2">No favorites yet.</h3>
      <p class="text-muted mb-3">
        Start swiping and like some movies — they’ll show up here.
      </p>
    </div>
  {{/if}}

</div>

<style>
  .transition-card {
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .transition-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 1rem 1.5rem rgba(0, 0, 0, 0.15);
  }
</style>