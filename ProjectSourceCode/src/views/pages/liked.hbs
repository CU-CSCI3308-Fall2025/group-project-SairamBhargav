{{> navbar }}

<div class="container mt-4">
  <h1>{{username}}'s Favorite Movies</h1>

  {{#if error}}
    <div class="alert alert-danger">{{error}}</div>
  {{/if}}

  <div class="row">
    {{#each movies}}
      <div class="col-md-3 mb-4">
        <div class="card h-100">
          {{#if posterPath}}
            <img src="{{posterPath}}" class="card-img-top" alt="{{title}}" />
          {{else}}
            <div
              class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
              style="height: 450px;"
            >
              <span class="text-white">No Image</span>
            </div>
          {{/if}}
          <div class="card-body">
            <h5 class="card-title">{{title}}</h5>
            <p class="card-text">{{overview}}</p>
            <p class="text-muted">Rating: {{rating}}/10</p>
            <p class="text-muted">Release: {{releaseDate}}</p>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>