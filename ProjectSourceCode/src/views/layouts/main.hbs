<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MatchFlix</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Fredoka+One&display=swap" rel="stylesheet">
    
    <style>
      /* Hover highlight for navbar links */
      .navbar .nav-link:hover {
        background-color: #d6c8ff;   /* light purple highlight */
        border-radius: 6px;          /* smooth rounded corners */
        color: #3a2470 !important;   /* darker purple text on hover */
        transition: 0.2s ease-in-out;
      }

      /* Hover highlight for dropdown items */
      .dropdown-menu .dropdown-item:hover {
        background-color: #c9b6ff;   /* slightly brighter highlight */
        color: #2e1e5c !important;
        transition: 0.2s ease-in-out;
      }
    </style>
    <!-- Optional: include a CSS file -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    {{! <link rel="stylesheet" href="/styles.css" /> }}
  </head>
  <body>
    <!-- Navbar will be included on every page -->

    <!-- Page content will be injected here -->
    {{{body}}}

    <!-- Bootstrap JS for dropdown and mobile navbar -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    ></script>

    <!-- Optional: Your custom JS -->
    {{! <script src="/scripts.js"></script> }}
  </body>
</html>